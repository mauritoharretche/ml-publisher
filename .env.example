DJANGO_SECRET_KEY=change-this-development-only-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=ml_publisher
POSTGRES_USER=ml_publisher
POSTGRES_PASSWORD=change-this-local-db-password
POSTGRES_PORT=5432
MAX_UPLOAD_SIZE=10485760
# Credenciales de la aplicación, nunca tokens de sellers.
MERCADO_LIBRE_CLIENT_ID=
MERCADO_LIBRE_CLIENT_SECRET=
# Debe ser HTTPS y coincidir exactamente con la URI registrada en Mercado Libre.
MERCADO_LIBRE_REDIRECT_URI=
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MERCADO_LIBRE_ENCRYPTION_KEY=
MERCADO_LIBRE_TIMEOUT=10
# Escrituras deshabilitadas por defecto. Sólo se admiten sellers con tag test_user.
MERCADO_LIBRE_ENABLE_TEST_WRITES=false
MERCADO_LIBRE_TEST_SELLER_ID=
# Producción permanece bloqueada hasta una habilitación manual y acotada.
MERCADO_LIBRE_ENABLE_PRODUCTION_WRITES=false
MERCADO_LIBRE_PRODUCTION_SELLER_ID=
# IA opcional: las imágenes sólo se envían después de solicitarlo explícitamente.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=30
OPENAI_MAX_ENRICHMENT_IMAGES=4
MUSICBRAINZ_USER_AGENT=ML-Publisher/0.1 (local development)
